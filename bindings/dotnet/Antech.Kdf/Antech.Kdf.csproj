<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Antech.Kdf</PackageId>
    <Version>0.1.0</Version>
    <Authors>Udinmo, Inc.</Authors>
    <Description>Antech KDF — thin .NET wrapper over the canonical Rust FFI</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/udinmoInc/antech-kdf</RepositoryUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
