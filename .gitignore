# Cargo build output
/target/
**/target/
# Root Cargo.lock is tracked for reproducible production builds.
/research/code/Cargo.lock
/fuzz/harness/Cargo.lock

# Executables & Binaries
*.exe
*.dll
*.so
*.dylib
*.pdb
*.o
*.obj

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# System & OS generated files
.DS_Store
Thumbs.db
*.log

# Temporary & Scratch files
/scratch/
**/scratch/
tmp/
*.tmp

# External research-only vendor trees (not Antech source)
/research/third_party/argon2-gpu/

# Staged native SDK libraries (built locally / CI artifacts)
/sdk/native/
/bindings/**/native/
/bindings/node/dist/
/bindings/node/node_modules/

# Local CI artifact downloads + grown corpora (large; keep summaries/reports only)
research/results/fuzz/ci-download*/
research/results/fuzz/ci/corpus/

